<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Short sounds played at once and overlapping (typing, games, notifications): an always-running mixer, WAV decoding and resampling. Pick an output: Xylocopadream.Audio.MiniAudio (every platform) or Xylocopadream.Audio.Wasapi (Windows).</Description>
    <PackageTags>audio;sound;mixer;wav;low-latency</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Xylocopadream.Audio.Tests" />
  </ItemGroup>
</Project>
